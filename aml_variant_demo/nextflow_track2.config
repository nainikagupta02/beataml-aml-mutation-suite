nextflow.enable.dsl=2
params.outdir="${projectDir}/results/track2"
params.seed=20260917
params.expected="${projectDir}/track2_expected_results.tsv"
params.sources="${projectDir}/track2_sources.tsv"
params.coords="${projectDir}/track2_coordinates.tsv"
params.flt3_ref="${projectDir}/track2_discovery/dna_test/flt3_grch38_amplicon.fa"
params.flt3_anno="${projectDir}/track2_discovery/dna_test/flt3_grch38_annotation.tsv"
params.kallisto_index="${projectDir}/track2_discovery/pizzly/gencode.v50.pizzly.full.kallisto.idx"
params.gencode_gtf="${projectDir}/track2_discovery/pizzly/gencode.v50.annotation.gtf"
params.gencode_fasta="${projectDir}/track2_discovery/pizzly/gencode.v50.transcripts.pizzly.fa"
params.mv_dna='https://depmap-omics-ccle.s3.amazonaws.com/data/wgs/bam/CDS-XBgVc6.wgs_ccle.bam'
params.mv_dna_index='https://depmap-omics-ccle.s3.amazonaws.com/data/wgs/bai/CDS-XBgVc6.wgs_ccle.bai'
params.kasumi_dna='https://depmap-omics-ccle.s3.amazonaws.com/data/wgs/cram/CDS-pouIEM.cram'
params.kasumi_dna_index='https://depmap-omics-ccle.s3.amazonaws.com/data/wgs/crai/CDS-pouIEM.crai'
params.kasumi_kind='cram'
params.grch38_reference="${projectDir}/track2_discovery/reference/GRCh38.d1.vd1.fa"
params.kasumi_rna='https://gdc-ccle-2-open.s3.amazonaws.com/1d773201-98be-4949-aa7d-c0b5af805ce4/G30554.KASUMI-1.1.bam'
params.kasumi_rna_index='https://gdc-ccle-2-open.s3.amazonaws.com/dd335d0e-0b5c-473e-ad4d-5fdc17ee44cc/G30554.KASUMI-1.1.bam.bai'
params.nb4_rna='https://gdc-ccle-2-open.s3.amazonaws.com/b5754d4b-87ef-4d46-9e82-6e33cd246d6b/G26239.NB-4.2.bam'
params.nb4_rna_index='https://gdc-ccle-2-open.s3.amazonaws.com/3a6e5b07-9b45-4324-a7a2-d0025ab5ed87/G26239.NB-4.2.bam.bai'
profiles {
  local { process.executor='local'; process.conda="${projectDir}/.conda/envs/aml-variant-demo"; conda.enabled=true; executor.cpus=4; executor.memory='12 GB' }
  replay { process.executor='local'; conda.enabled=false; executor.cpus=4; executor.memory='12 GB' }
}
process { errorStrategy='terminate'; maxRetries=0; shell=['/bin/bash','-euo','pipefail']; beforeScript="export PYTHONHASHSEED=${params.seed}"; cpus=4; memory='8 GB' }
trace { enabled=true; file="${params.outdir}/execution_trace.tsv"; overwrite=true; fields='task_id,hash,process,tag,status,exit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir' }
report { enabled=true; file="${params.outdir}/nextflow_report.html"; overwrite=true }
timeline { enabled=true; file="${params.outdir}/nextflow_timeline.html"; overwrite=true }
