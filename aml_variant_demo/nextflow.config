nextflow.enable.dsl = 2

params.outdir = "${projectDir}/results/track1"
params.seed = 20260916
params.min_truth_variants = 200
params.threads = 4
params.tumor_url = 'https://ftp.ncbi.nlm.nih.gov/ReferenceSamples/seqc/Somatic_Mutation_WG/data/WES/WES_LL_T_1.bwa.dedup.bam'
params.normal_url = 'https://ftp.ncbi.nlm.nih.gov/ReferenceSamples/seqc/Somatic_Mutation_WG/data/WES/WES_LL_N_1.bwa.dedup.bam'
params.tumor_sample = 'WES_LL_T_1'
params.normal_sample = 'WES_LL_N_1'

profiles {
    local {
        process.executor = 'local'
        process.conda = "${projectDir}/.conda/envs/aml-variant-demo"
        conda.enabled = true
        executor.cpus = 4
        executor.memory = '12 GB'
        process.resourceLimits = [cpus: 4, memory: '12 GB']
    }
}

process {
    errorStrategy = 'terminate'
    maxRetries = 0
    shell = ['/bin/bash', '-euo', 'pipefail']
    beforeScript = "export PYTHONHASHSEED=${params.seed}"

    withName:FETCH_RESOURCES {
        cpus = 2
        memory = '4 GB'
    }
    withName:BUILD_VALIDATION_REGIONS {
        cpus = 2
        memory = '4 GB'
    }
    withName:SLICE_REMOTE_BAMS {
        cpus = 4
        memory = '4 GB'
    }
    withName:MUTECT2_CALL {
        cpus = 4
        memory = '10 GB'
    }
    withName:FILTER_CALLS {
        cpus = 2
        memory = '6 GB'
    }
    withName:BENCHMARK_CALLS {
        cpus = 2
        memory = '4 GB'
    }
}

trace {
    enabled = true
    file = "${params.outdir}/execution_trace.tsv"
    overwrite = true
    fields = 'task_id,hash,process,tag,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir'
}
report {
    enabled = true
    file = "${params.outdir}/nextflow_report.html"
    overwrite = true
}
timeline {
    enabled = true
    file = "${params.outdir}/nextflow_timeline.html"
    overwrite = true
}
